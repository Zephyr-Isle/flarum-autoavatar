{
    "name": "zephyrisle/flarum-autoavatar",
    "description": "Automatically generate and set avatars for new users in Flarum.",
    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "avatar",
        "auto-avatar",
        "multiavatar"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Zephyr Isle"
        }
    ],
    "support": {
        "issues": "https://github.com/Zephyr-Isle/flarum-AutoAvatar/issues",
        "source": "https://github.com/Zephyr-Isle/flarum-AutoAvatar"
    },
    "require": {
        "flarum/core": "^2.0",
        "multiavatar/multiavatar-php": "^1.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Zephyrisle\\AutoAvatar\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Auto Avatar",
            "category": "feature",
            "icon": {
                "name": "fas fa-user-tag",
                "backgroundColor": "#2196f3",
                "color": "#fff"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
